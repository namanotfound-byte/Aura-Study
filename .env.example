# Copy this file to .env and fill in real values. .env is git-ignored.
# Never commit real secrets.

# Flask session secret. If left empty a random key is generated per-boot (dev only) --
# set this explicitly in any deployment where sessions/cookies must survive a restart.
SECRET_KEY=

# Base URL this app is served from. Used to build email links (verify/reset) and the
# Spotify OAuth redirect URI. Use the literal loopback IP for local dev, not "localhost".
APP_BASE_URL=http://127.0.0.1:5055

# Port the dev server listens on. 5000 is taken by macOS AirPlay Receiver -- don't use it.
PORT=5055

# Path to the SQLite database file. Defaults to <project root>/aurastudy.db.
# Only used when DATABASE_URL (below) is empty.
DATABASE_PATH=

# Postgres connection string (e.g. from Neon). Leave empty for local dev --
# the app falls back to the SQLite file at DATABASE_PATH with zero
# configuration. Setting this (to anything) switches the app into
# "production" mode: SECRET_KEY/TOKEN_ENC_KEY/SMTP_HOST become mandatory
# and the dev-outbox email fallback is disabled. sslmode=require is added
# automatically if you paste a string without it -- Neon requires TLS.
DATABASE_URL=

# Set to "production" to force production-mode checks even if DATABASE_URL
# is left pointing at SQLite for some reason. Normally you don't need this
# locally -- leave it empty. (A real deployment sets this explicitly too,
# alongside DATABASE_URL, so it's never ambiguous from the dashboard alone.)
ENVIRONMENT=

# Fernet key used to encrypt Spotify tokens at rest. Auto-generated into .env on first
# run if left empty -- you normally never need to set this by hand.
TOKEN_ENC_KEY=

# Brevo HTTP API key, used instead of SMTP to send verification/reset emails. Exists
# because Render's free web tier blocks outbound traffic to SMTP ports 25/465/587 (since
# 2025-09-26), so plain SMTP can never reach a mail provider from that host -- Brevo's
# REST API runs over port 443 instead, which isn't blocked. When set, server/mailer.py
# uses this in preference to the SMTP_* settings below. Get it from the Brevo dashboard
# -> SMTP & API -> the "API Keys" tab (NOT the "SMTP" tab -- that page generates a
# different credential, an SMTP key, which won't work here). Leave empty for local dev;
# SMTP_HOST empty too means "dev outbox" mode (see below).
BREVO_API_KEY=

# SMTP settings for sending real verification/reset emails. Only used when
# BREVO_API_KEY (above) is empty. Leave both empty to use "dev outbox" mode: emails are
# written to server/dev_outbox/ and the verification / reset URL is printed to stdout
# instead of actually being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AuraStudy <no-reply@aurastudy.local>
SMTP_USE_TLS=true

# Spotify app credentials. See the README "Create your Spotify app" section.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Require users to verify their email before they can log in.
REQUIRE_EMAIL_VERIFICATION=true

# Email address of the app owner. Gates every /admin/* page: GET /admin
# (index), GET /admin/spotify-requests (a list of users' submitted Spotify
# account emails, for the owner to add by hand to the Spotify app's
# Development Mode User Management allowlist -- max 25 accounts),
# GET /admin/users (per-user weekly totals + the study-time correction
# form), GET /admin/support (the doubts/support inbox), and GET
# /admin/actions (the audit log of every correction made). Must match the
# owner's own AuraStudy account email exactly (case-insensitive). Leave
# empty to keep every one of those pages unreachable for everyone,
# including you -- it never falls open just because this is unset.
OWNER_EMAIL=
